# Android Studio normally adds sdk.dir automatically.
sdk.dir=C\:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk

# Use your Supabase publishable key. Never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Optional Firebase Cloud Messaging values.
FIREBASE_APPLICATION_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
